{
  "name": "@mandate-court/mcp-server",
  "version": "0.2.0",
  "type": "module",
  "description": "Model Context Protocol server for Mandate Court. Signs wallet authorizations locally and exposes the full mandate lifecycle as MCP tools, resources, and prompts.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/TS-mfon/mandate-court.git", "directory": "packages/mcp-server" },
  "homepage": "https://github.com/TS-mfon/mandate-court/blob/master/docs/mcp.md",
  "bugs": { "url": "https://github.com/TS-mfon/mandate-court/issues" },
  "keywords": ["mcp", "model-context-protocol", "ai-agents", "agent-skills", "escrow", "ethereum", "base", "usdc", "eip-712"],
  "engines": { "node": ">=20" },
  "bin": { "mandate-court-mcp": "./dist/index.js" },
  "files": ["dist", "skills", "README.md"],
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mandate-court/sdk": "workspace:*",
    "tsx": "4.23.12",
    "viem": "2.56.0"
  }
}
