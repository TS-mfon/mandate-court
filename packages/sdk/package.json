{
  "name": "@mandate-court/sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "TypeScript client for the Mandate Court REST API.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/TS-mfon/mandate-court.git", "directory": "packages/sdk" },
